# LF in the working copy whatever core.autocrlf says (Git for Windows sets it to true): some
# tests read the docs byte for byte, docs/protocolo.md among them.
* text=auto eol=lf
*.sh text eol=lf
*.rs text eol=lf

# Test fixtures are signed byte for byte: never convert their line endings.
src/crisol-core/src/catalog/testdata/* -text

# The php.ini excerpt keeps the CRLF that PHP ships it with: the tests check it is preserved.
src/crisol-core/src/phpini/testdata/* -text
