source: crisol-core/src/nginx/tests.rs
expression: normalised(text)
---
# Generated by Crisol. Do not edit: it is rewritten whenever the sites change.
# Your own settings go in the overrides folder (see nginx.conf).

# blog.test: parked site, plain folder
server {
    listen 127.0.0.1:80;
    server_name blog.test;
    root "D:/blog";
    index index.php index.html;
    charset utf-8;
    error_log "<home>/logs/nginx/blog.error.log" warn;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    # Hidden files (.env, .git…) are never served.
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Windows ignores the case of a name and a trailing dot or space, so `.php` is
    # matched without regard to case and with those endings: `/wp-config.PHP` and
    # `/wp-config.php.` run the script, they are never sent as text.
    # No PHP version is installed for this site.
    location ~* "\.php[. ]*$" {
        return 503;
    }

    include "<home>/etc/nginx/overrides/sites/blog/*.conf";
}
