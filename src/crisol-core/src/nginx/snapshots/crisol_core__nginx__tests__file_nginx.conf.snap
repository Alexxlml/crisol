# Generated by Crisol. Do not edit: it is rewritten whenever the sites change.
# Your own settings go in the overrides folder (see nginx.conf).
# User settings: <home>/etc/nginx/overrides/*.conf (inside http) and
# <home>/etc/nginx/overrides/sites/<site>/*.conf (inside that site's server).

worker_processes 1;
error_log "<home>/logs/nginx/error.log" warn;
pid "<home>/state/nginx/nginx.pid";

events {
    worker_connections 1024;
}

http {
    include "<home>/bin/nginx/1.28.3/conf/mime.types";
    default_type application/octet-stream;
    access_log "<home>/logs/nginx/access.log";
    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 128m;
    server_names_hash_bucket_size 128;
    client_body_temp_path "<home>/state/nginx/client_body_temp";
    proxy_temp_path "<home>/state/nginx/proxy_temp";
    fastcgi_temp_path "<home>/state/nginx/fastcgi_temp";
    uwsgi_temp_path "<home>/state/nginx/uwsgi_temp";
    scgi_temp_path "<home>/state/nginx/scgi_temp";

    include "<home>/etc/nginx/php_upstream.conf";

    # Any host that is not a site: close the connection.
    server {
        listen 127.0.0.1:80 default_server;
        listen [::1]:80 default_server;
        server_name _;
        # Whether Nginx runs this configuration yet (the name changes with it).
        location = /.crisol-config-b3329334f8521e40 {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            return 204;
        }
        location / {
            return 444;
        }
    }

    include "<home>/etc/nginx/sites/*.conf";
    include "<home>/etc/nginx/overrides/*.conf";
}
