# Generated by Crisol. Do not edit: it is rewritten whenever the sites change.
# Your own settings go in the overrides folder (see nginx.conf).

# docs.test: parked site, plain folder
server {
    listen 127.0.0.1:80;
    server_name docs.test;
    root "D:/code/docs";
    index index.php index.html;
    charset utf-8;
    error_log "<home>/logs/nginx/docs.error.log" warn;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    # Hidden files (.env, .git…) are never served.
    location ~ /\.(?!well-known) {
        deny all;
    }

    # No PHP version is installed for this site.
    location ~ \.php$ {
        return 503;
    }

    include "<home>/etc/nginx/overrides/sites/docs/*.conf";
}
