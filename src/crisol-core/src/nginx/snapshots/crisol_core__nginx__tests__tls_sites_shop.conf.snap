# Generated by Crisol. Do not edit: it is rewritten whenever the sites change.
# Your own settings go in the overrides folder (see nginx.conf).

# shop.test: plain HTTP goes to HTTPS. A 302, not a 301: browsers keep a 301 for
# good, and the site would look broken after being unsecured.
server {
    listen 127.0.0.1:80;
    listen [::1]:80;
    server_name shop.test;
    return 302 https://$host$request_uri;
}

# shop.test: parked site, Laravel
server {
    listen 127.0.0.1:443 ssl;
    listen [::1]:443 ssl;
    http2 on;
    ssl_certificate "<home>/certs/sites.pem";
    ssl_certificate_key "<home>/certs/sites.key";
    ssl_protocols TLSv1.2 TLSv1.3;
    server_name shop.test;
    root "D:/shop/public";
    index index.php index.html;
    charset utf-8;
    error_log "<home>/logs/nginx/shop.error.log" warn;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico {
        access_log off;
        log_not_found off;
    }

    # Hidden files (.env, .git…) are never served.
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Windows ignores the case of a name and a trailing dot or space, so `.php` is
    # matched without regard to case and with those endings: `/wp-config.PHP` and
    # `/wp-config.php.` run the script, they are never sent as text.
    location ~* "\.php[. ]*$" {
        try_files $uri =404;
        include "<home>/bin/nginx/1.28.3/conf/fastcgi_params";
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_pass php_8_4_26;
        fastcgi_read_timeout 300;
    }

    include "<home>/etc/nginx/overrides/sites/shop/*.conf";
}
