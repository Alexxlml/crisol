---
source: crisol-core/src/phpini/tests.rs
expression: "changes(EXCERPT, &generated.text)"
---
- max_execution_time = 30
- memory_limit = 128M
- ;error_log = php_errors.log
- post_max_size = 8M
- ;extension_dir = "ext"
- upload_max_filesize = 2M
- ;extension=bz2
- ;extension=curl
- ;extension=ftp
- ;extension=fileinfo
- ;extension=gd
- ;extension=gettext
- ;extension=gmp
- ;extension=intl
- ;extension=mbstring
- ;extension=exif      ; Must be after mbstring as it depends on it
- ;extension=mysqli
- ;extension=openssl
- ;extension=pdo_mysql
- ;extension=pdo_pgsql
- ;extension=pdo_sqlite
- ;extension=pgsql
- ;extension=soap
- ;extension=sockets
- ;extension=sodium
- ;extension=sqlite3
- ;extension=zip
- ;zend_extension=opcache
+ ; php.ini for PHP 8.4.26 generated by Crisol from php.ini-development.
+ ; Do not edit: this file is rewritten. Put your own settings in
+ ; C:\Crisol\etc\php\overrides\*.ini
+ max_execution_time = 120
+ memory_limit = 512M
+ error_log = "C:/Crisol/logs/php/php_errors.log"
+ post_max_size = 128M
+ extension_dir = "C:/Crisol/bin/php/8.4.26/ext"
+ upload_max_filesize = 128M
+ extension=bz2
+ extension=curl
+ extension=ftp
+ extension=fileinfo
+ extension=gd
+ extension=gettext
+ extension=gmp
+ extension=intl
+ extension=mbstring
+ extension=exif      ; Must be after mbstring as it depends on it
+ extension=mysqli
+ extension=openssl
+ extension=pdo_mysql
+ extension=pdo_pgsql
+ extension=pdo_sqlite
+ extension=pgsql
+ extension=soap
+ extension=sockets
+ extension=sodium
+ extension=sqlite3
+ extension=zip
+ zend_extension=opcache
+ ; ---- Added by Crisol (the shipped file has no line for these) ----
+ session.upload_progress.enabled = Off
