{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crisol",
  "identifier": "dev.crisol.gui",
  "build": { "frontendDist": "./ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Crisol",
        "width": 980,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon-32.png", "icons/icon-128.png", "icons/icon.ico"]
  }
}
